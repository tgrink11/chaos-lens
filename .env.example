# Copy this to .env.local for local `vercel dev` testing.
# In production, set these in the Vercel dashboard: Project -> Settings -> Environment Variables.

# Your FMP enterprise API key.
FMP_API_KEY=

# A random string you invent (e.g. `openssl rand -hex 20`). Required as ?key=
# on every call to /api/scan so randoms can't hit your endpoint and burn FMP quota.
SCAN_SECRET=
